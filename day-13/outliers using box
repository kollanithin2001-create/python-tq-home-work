import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

df = pd.DataFrame({
    "Salary": [
        50000, 52000, 55000, 57000, 60000,
        62000, 65000, 68000, 70000, 150000
    ]
})

# Create a box plot
plt.figure(figsize=(8, 4))
sns.boxplot(x=df["Salary"], color="skyblue")
plt.title("Salary Box Plot")
plt.xlabel("Salary")
plt.tight_layout()
plt.show()

# Calculate IQR
Q1 = df["Salary"].quantile(0.25)
Q3 = df["Salary"].quantile(0.75)
IQR = Q3 - Q1

lower_limit = Q1 - (1.5 * IQR)
upper_limit = Q3 + (1.5 * IQR)

print("Q1:", Q1)
print("Q3:", Q3)
print("IQR:", IQR)
print("Lower limit:", lower_limit)
print("Upper limit:", upper_limit)

# Identify outliers
outliers = df[
    (df["Salary"] < lower_limit) |
    (df["Salary"] > upper_limit)
]

print("\nOutliers:")
print(outliers)

# Remove outliers
clean_df = df[
    (df["Salary"] >= lower_limit) &
    (df["Salary"] <= upper_limit)
]

print("\nData after removing outliers:")
print(clean_df)