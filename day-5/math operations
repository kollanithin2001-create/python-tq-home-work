import numpy as np

a = np.array([10, 20, 30])
b = np.array([2, 4, 5])

print("Addition:", a + b)
# [12 24 35]

print("Subtraction:", a - b)
# [ 8 16 25]

print("Multiplication:", a * b)
# [ 20  80 150]

print("Division:", a / b)
# [5. 5. 6.]

# Operations with a single number
print("Add 5:", a + 5)
# [15 25 35]

print("Multiply by 2:", a * 2)
# [20 40 60]