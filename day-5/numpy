import numpy as np

# One-dimensional array
array_1d = np.array([10, 20, 30, 40, 50])

# Two-dimensional array: 2 rows and 3 columns
array_2d = np.array([
    [10, 20, 30],
    [40, 50, 60]
])

print("1D array:")
print(array_1d)
print("Shape:", array_1d.shape)  # (5,)
print("Size:", array_1d.size)    # 5
print("Dimensions:", array_1d.ndim)  # 1

print("\n2D array:")
print(array_2d)
print("Shape:", array_2d.shape)  # (2, 3)
print("Size:", array_2d.size)    # 6
print("Dimensions:", array_2d.ndim)  # 2