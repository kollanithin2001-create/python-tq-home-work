import numpy as np

numbers = np.array([10, 20, 30, 40, 50])

print("First element:", numbers[0])    # 10
print("Last element:", numbers[-1])    # 50
print("Index 1 to 3:", numbers[1:4])    # [20 30 40]
print("First three:", numbers[:3])     # [10 20 30]
print("Every second:", numbers[::2])   # [10 30 50]

matrix = np.array([
    [10, 20, 30],
    [40, 50, 60],
    [70, 80, 90]
])

# Syntax: matrix[row, column]
print("Row 2, column 3:", matrix[1, 2])  # 60

print("First row:", matrix[0, :])       # [10 20 30]
print("Second column:", matrix[:, 1])   # [20 50 80]

print("First two rows:")
print(matrix[:2, :])
# [[10 20 30]
#  [40 50 60]]

print("Top-left 2 × 2 section:")
print(matrix[:2, :2])
# [[10 20]
#  [40 50]]