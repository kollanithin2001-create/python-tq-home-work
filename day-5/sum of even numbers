# 1. Sum of even numbers
total = 0

for number in range(1, 21):
    if number % 2 == 0:
        total += number

print("Sum of even numbers:", total)  # 110


# 2. Count vowels
def count_vowels(text):
    count = 0

    for character in text.lower():
        if character in "aeiou":
            count += 1

    return count


print("Vowel count:", count_vowels("Hello Python"))  # 3


# 3. Find the largest number in a nonempty list
numbers = [12, 45, 7, 89, 23]
largest = numbers[0]

for number in numbers:
    if number > largest:
        largest = number

print("Largest number:", largest)  # 89


# 4. Calculate factorial
def factorial(number):
    if number < 0:
        raise ValueError("Enter a nonnegative integer.")

    result = 1

    for value in range(1, number + 1):
        result *= value

    return result


print("Factorial:", factorial(5))  # 120